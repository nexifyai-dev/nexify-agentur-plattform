{
  "mcpServers": {
    "agentmemory": {
      "command": "npx",
      "args": [
        "-y",
        "@agentmemory/mcp"
      ],
      "env": {
        "AGENTMEMORY_URL": "http://127.0.0.1:3111",
        "AGENTMEMORY_SECRET": "${AGENTMEMORY_SECRET}",
        "AGENTMEMORY_TOOLS": "all",
        "AGENTMEMORY_INJECT_CONTEXT": "true"
      },
      "description": "Systemweites Betriebsgedächtnis (Pflicht). REST :3111, Viewer :3113. TOOLS=all = voller Tool-Satz (nicht nur Shim)."
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "description": "Aktuelle Bibliotheks-/API-Dokumentation zur Verifikation vor Übernahme."
    },
    "lightrag": {
      "command": "python3",
      "args": [
        "/opt/nexifyai/mcp-servers/lightrag-mcp.py"
      ],
      "env": {
        "LIGHTRAG_URL": "http://127.0.0.1:9622"
      },
      "description": "LightRAG Knowledge Graph (Vektorsuche). Origin :9622 — Secrets nur Env. Embedding IST: Upstage embedding-passage."
    },
    "gitlab-oss": {
      "command": "npx",
      "args": [
        "-y",
        "@zereight/mcp-gitlab"
      ],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${GITLAB_PERSONAL_ACCESS_TOKEN}",
        "GITLAB_API_URL": "https://gitlab.nexifyai.cloud/api/v4",
        "GITLAB_READ_ONLY_MODE": "false"
      },
      "description": "Self-hosted GitLab OSS (VPS). Nicht built-in Gitlab-SaaS-MCP verwenden."
    },
    "hostinger-domains": {
      "command": "/opt/nexifyai/scripts/hostinger-mcp-wrapper.sh",
      "args": [
        "hostinger-domains-mcp"
      ],
      "description": "Hostinger Domains MCP — token via /etc/nexifyai/hostinger-api.env (wrapper)."
    },
    "hostinger-dns": {
      "command": "/opt/nexifyai/scripts/hostinger-mcp-wrapper.sh",
      "args": [
        "hostinger-dns-mcp"
      ],
      "description": "Hostinger DNS MCP — token via env file; never commit secrets."
    },
    "hostinger-vps": {
      "command": "/opt/nexifyai/scripts/hostinger-mcp-wrapper.sh",
      "args": [
        "hostinger-vps-mcp"
      ],
      "description": "Hostinger VPS MCP — read-first; no destructive deletes without approval."
    }
  },
  "_comments": {
    "agentmemory_single": "Prefer EINEN agentmemory-Eintrag mit AGENTMEMORY_TOOLS=all. Nicht zusätzlich einen zweiten 'user-agentmemory' mit Teil-Toolset parallel aktiv halten, wenn beide denselben :3111 treffen — doppelte Recall/Save und Cursor zeigt project-0-* vs user-* Duplikate.",
    "project_vs_user_duplicate": "Cursor kann Project-MCP (.cursor/mcp.json) UND User-MCP (~/.cursor/mcp.json) laden. Bei Duplikat-Servern (agentmemory, lightrag, context7, gitlab-oss): Project-Example ist kanonisch für dieses Repo; User-Kopie deaktivieren oder identisch halten, sonst Tool-Noise und Circuit-Breaker-Wiederholungen.",
    "secrets": "Nie echte Secrets in mcp.json committen — nur ${ENV}-Platzhalter. Lokal: cp .cursor/mcp.json.example .cursor/mcp.json",
    "dual_write": "Optionaler Commit-Dual-Write: docs/operations/BRAIN-DUAL-WRITE.md — nicht Teil von MCP."
  }
}
