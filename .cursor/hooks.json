{
  "version": 1,
  "hooks": {
    "beforeMCPExecution": [
      {
        "command": ".cursor/hooks/circuit-breaker-mcp.sh",
        "failClosed": false
      }
    ],
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/auto-push-agent-branch.sh",
        "matcher": "git\\s+commit",
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/auto-push-agent-branch.sh",
        "failClosed": false
      }
    ],
    "sessionStart": [
      {
        "type": "prompt",
        "timeout": 12,
        "prompt": "Automations-Pflicht: Event-Ingest (Cloud/VPS) + Auto-Push nach Commit + Draft-PR + label automerge. Docs: docs/operations/CLOUD-AGENT-EVENT-INGEST.md. memory_recall vor Planung; memory_save nach Task. Keine Secrets."
      }
    ]
  }
}
