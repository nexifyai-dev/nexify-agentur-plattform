      "status": "aktiv"
    },
    {
      "id": "CRON-DRIFT-001",
      "name": "Secret Presence Check",
      "schedule": "0 7 * * *",
      "skript": "nexify-auto.sh security",
      "log": "/workspace/nexify/logs/production/drift.log",
      "kategorie": "drift",
      "status": "aktiv"
    },
    {
      "id": "CRON-DRIFT-002",
      "name": "Deployment Validation",
      "schedule": "0 10 * * *",
      "skript": "deploy-production.sh status",
      "log": "/workspace/nexify/logs/production/deploy-status.log",
      "kategorie": "drift",
      "status": "aktiv"
    },
    {
      "id": "CRON-DRIFT-003",
      "name": "Kanban Aging Check",
      "schedule": "0 6-20 * * 1-5",
      "skript": "nexify-auto.sh status",
      "log": "/workspace/nexify/logs/production/kanban.log",
      "kategorie": "drift",
      "status": "aktiv"
    },
    {
      "id": "CRON-SYS-001",
      "name": "Log Rotation",
      "schedule": "30 0 * * *",
      "skript": "find ${LOG_DIR} -name '*.log' -mtime +30 -delete",
      "log": "n/a",
      "kategorie": "wartung",
      "status": "aktiv"
    },
    {
      "id": "CRON-SYS-002",
      "name": "Temp Cleanup",
      "schedule": "30 6 * * *",
      "skript": "find /tmp -name 'nexify-*' -mtime +1 -delete",
      "log": "n/a",
      "kategorie": "wartung",
      "status": "aktiv"
    }
  ],
  "systemd_timer": [
    {
      "id": "TIMER-001",
      "name": "nexify-health.timer",
      "service": "nexify-health.service",
      "schedule": "OnBootSec=5min, OnUnitActiveSec=5min",
