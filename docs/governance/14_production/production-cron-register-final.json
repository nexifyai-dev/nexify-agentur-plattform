      "kategorie": "cloudflare",
      "status": "aktiv"
    },
    {
      "id": "CRON-CF-005",
      "name": "Cloudflare Analytics Report",
      "schedule": "0 9 * * *",
      "skript": "cf-analytics-monitoring.sh nexifyai.cloud report 24h",
      "log": "/workspace/nexify/logs/production/cf-report.log",
