      "status": "aktiv"
    },
    {
      "id": "CRON-PROD-003",
      "name": "Security Scan",
      "schedule": "0 3 * * *",
      "skript": "nexify-production-master.sh security",
      "log": "/workspace/nexify/logs/production/security.log",
      "kategorie": "security",
      "status": "aktiv"
    },
    {
      "id": "CRON-PROD-004",
      "name": "Update Check",
      "schedule": "0 4 * * *",
      "skript": "nexify-production-master.sh update",
