    },
    {
      "id": "TIMER-002",
      "name": "nexify-backup.timer",
      "service": "nexify-backup.service",
      "schedule": "OnCalendar=*-*-* 02:00:00",
      "status": "definiert"
    },
    {
      "id": "TIMER-003",
      "name": "nexify-security.timer",
      "service": "nexify-security.service",
      "schedule": "OnCalendar=*-*-* 03:00:00",
      "status": "definiert"
    }
  ],
