{
  "policy": "brain_first_policy",
  "version": "1.0",
  "date": "2026-06-11",
  "active": true,
  "scope": "nexify_internal",
  "rules": [
    {
      "id": "BRAIN_FIRST-001",
      "statement": "Before non-trivial work, query Brain first",
      "binding_level": "mandatory"
    },
    {
      "id": "BRAIN_FIRST-002",
      "statement": "Store durable knowledge after changes",
      "binding_level": "mandatory"
    },
    {
      "id": "BRAIN_FIRST-003",
      "statement": "No systemmaster work with untested Brain",
      "binding_level": "mandatory"
    },
    {
      "id": "BRAIN_FIRST-004",
      "statement": "Report Brain status in every task completion",
      "binding_level": "mandatory"
    }
  ],
  "components": {
    "brain_api_local": "http://127.0.0.1:9090",
    "brain_api_cloudflare": "https://brain.nexifyai.cloud",
    "qdrant": "http://127.0.0.1:6333",
    "agentmemory": "http://127.0.0.1:3111",
    "brain_db": "/var/lib/nexify/brain.db",
    "brain_entries": 68,
    "qdrant_collections": {
      "nexifyai_brain": 3923,
      "nexifyai_memories": 2,
      "nexifyai_projects": 0,
      "nexifyai_rules": 0
    }
  },
  "fallback_chain": [
    "http://127.0.0.1:9090",
    "http://127.0.0.1:6333",
    "/workspace/nexify/11_brain_sync/"
  ],
  "conflicts": [
    {
      "component": "brain.nexifyai.cloud",
      "issue": "Leads to 9Router dashboard instead of Brain API",
      "status": "WAITING_FOR_APPROVAL"
    }
  ]
}
