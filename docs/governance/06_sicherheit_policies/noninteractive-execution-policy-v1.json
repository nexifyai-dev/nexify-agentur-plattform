{
  "policy": "noninteractive_execution_policy",
  "version": "1.0",
  "date": "2026-06-11",
  "active": true,
  "scope": "nexify_internal",
  "rules": [
    {"id": "NI-001", "statement": "No blocking confirmations for safe internal work", "binding": "mandatory"},
    {"id": "NI-002", "statement": "Gate tasks produce approval packages, not terminal prompts", "binding": "mandatory"},
    {"id": "NI-003", "statement": "Unknown prompts are captured, not blocking", "binding": "mandatory"},
    {"id": "NI-004", "statement": "Auto-approval matrix governs all tool use", "binding": "mandatory"},
    {"id": "NI-005", "statement": "Secrets must never appear in prompts or logs", "binding": "mandatory"},
    {"id": "NI-006", "statement": "Destructive commands require gate + rollback plan", "binding": "mandatory"}
  ],
  "auto_approval_categories": {
    "READONLY": "auto",
    "SAFE_INTERNAL": "auto",
    "TEST": "auto",
    "DOCS": "auto",
    "GATED": "approval_package",
    "SECRET_RISK": "blocked",
    "DESTRUCTIVE": "blocked",
    "EXTERNAL_WRITE": "approval_package",
    "UNKNOWN": "capture_and_hold"
  }
}
