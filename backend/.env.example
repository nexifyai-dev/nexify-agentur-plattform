# === NeXify AI — Backend Konfiguration ===
# Kopiere dies nach .env und fülle die Werte aus.
# SECRETS niemals committen (V01). Keys nur über Env / Secret-Store.

# === 9router AI (Primärer LLM-Provider — Vollintegration) ===
# Extern (Cloudflare): https://ai-router.nexifyai.cloud/v1
# VPS-intern:          http://127.0.0.1:20128/v1
NINEROUTER_BASE_URL=https://ai-router.nexifyai.cloud/v1
# Canonical key name (aliases also accepted: NINEROUTER_KEY, OPENAI_API_KEY)
NINEROUTER_API_KEY=dein-9router-system-key
# Agents / internal (combo = multi-provider chain inside 9router)
PRIMARY_MODEL=nexifyai-combo-llm
# Customer-facing chat/offers/planner — clean text, no reasoning leak
CUSTOMER_MODEL=ds/deepseek-v4-flash
# Used when primary/customer call fails or returns empty
FALLBACK_MODEL=ds/deepseek-v4-flash
# Optional: comma-separated allowlist (empty = no extra filter)
# NINEROUTER_MODEL_ALLOWLIST=ds/deepseek-v4-flash,nexifyai-combo-llm,nexifyai
# Optional health override (default derived from BASE_URL → /api/health)
# NINEROUTER_HEALTH_URL=https://ai-router.nexifyai.cloud/api/health
# Cost-Brake (GOVERNANCE §12): 0=disabled; >150 aborts; >200 P0 escalate
NINEROUTER_BUDGET_PCT=0
# Hermes parity (optional — same key/base as above)
# OPENAI_BASE_URL=http://127.0.0.1:20128/v1
# OPENAI_API_KEY=dein-9router-system-key

# === Supabase (Datenbank, Auth, Storage) ===
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_oder_anon_key

# === Stripe (Zahlungen) ===
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# === Resend (E-Mail) ===
RESEND_API_KEY=re_xxxx
RESEND_DOMAIN=mail.nexifyai.cloud
SENDER_EMAIL=mail@nexifyai.cloud
INTERNAL_NOTIFY_EMAIL=mail@nexifyai.cloud

# === IMAP (E-Mail-Empfang) ===
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=mail@nexifyai.cloud
IMAP_PASSWORD=dein-imap-passwort

# === Cloudflare ===
CF_ZONE_ID=2b96bbce5033dd364440906cea99b086
CF_GLOBAL_KEY=dein-global-key
CF_EMAIL=dein@email.com

# === Hermes WebUI (SSO) ===
WEBUI_SSO_SECRET=shared-secret-mit-hermes-webui
WEBUI_SSO_URL=https://work.nexifyai.cloud

# === Paperclip ===
PAPERCLIP_API_KEY=dein-paperclip-key
PAPERCLIP_API_URL=http://127.0.0.1:3100/api

# === n8n (Workflow-Automatisierung) ===
N8N_BASE_URL=https://n8n.nexifyai.cloud
N8N_API_KEY=dein-n8n-api-key

# === Umgebung ===
TZ=Europe/Berlin
PYTHONPATH=/app/backend
FRONTEND_URL=https://www.nexifyai.cloud
CORS_ORIGINS=*
