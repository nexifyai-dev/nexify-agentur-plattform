# === NeXify AI — Backend Konfiguration ===
# Kopiere dies nach .env und fülle die Werte aus.
# SECRETS niemals committen (V01). Keys nur über Env / Secret-Store.

# === 9router AI (Primärer LLM-Provider — Vollintegration) ===
# Extern (Cloudflare): https://ai-router.nexifyai.cloud/v1
# VPS-intern:          http://127.0.0.1:20128/v1
NINEROUTER_BASE_URL=https://ai-router.nexifyai.cloud/v1
# Canonical key name (aliases also accepted: NINEROUTER_KEY, OPENAI_API_KEY)
NINEROUTER_API_KEY=dein-9router-system-key
# Agents / internal — cheap-first combo (escalate inside 9router)
PRIMARY_MODEL=nexifyai-cheap-first
# Alternate combo with broader pool:
# PRIMARY_MODEL=nexifyai-combo-llm
# Customer-facing chat/offers/planner — clean text, no reasoning leak
CUSTOMER_MODEL=ds/deepseek-v4-flash
# Used when primary/customer call fails or returns empty
FALLBACK_MODEL=ds/deepseek-v4-flash
# Optional: comma-separated allowlist (empty = no extra filter)
# NINEROUTER_MODEL_ALLOWLIST=ds/deepseek-v4-flash,nexifyai-cheap-first,nexifyai-combo-llm,upstage/solar-mini
# Optional health override (default derived from BASE_URL → /api/health)
# NINEROUTER_HEALTH_URL=https://ai-router.nexifyai.cloud/api/health
# Cost-Brake (GOVERNANCE §12): 0=disabled; >150 aborts; >200 P0 escalate
NINEROUTER_BUDGET_PCT=0
# Hermes parity (optional — same key/base as above)
# OPENAI_BASE_URL=http://127.0.0.1:20128/v1
# OPENAI_API_KEY=dein-9router-system-key

# === Circuit Breaker + Brain (names only) ===
# CIRCUIT_BREAKER_URL=http://127.0.0.1:8912
# AGENTMEMORY_URL=http://127.0.0.1:3111
# AGENTMEMORY_SECRET=
# LIGHTRAG_URL=http://127.0.0.1:9622
# HERMES_GATEWAY_URL=http://127.0.0.1:8644

# === §10 Systemweite Standardmodelle (3 Modelle, task-basiertes Routing) ===
# 1. Upstage Solar Pro 3 — Premium DE/NL-Qualität (Primär-Provider per §10)
UPSTAGE_MODEL=upstage/solar-pro3
# 2. DeepSeek Chat (V3.2) — strukturiertes JSON, Angebote, Pläne (§10-Ausnahme: vollintegriert)
DEEPSEEK_MODEL=ds/deepseek-chat
# 3. Upstage Solar Mini — günstigstes Standardmodell für Support & einfache Texte
UPSTAGE_MINI=upstage/solar-mini
# Optional: DeepSeek Reasoning für komplexe interne Aufgaben (kein Kunden-Output direkt)
DEEPSEEK_REASONER=ds/deepseek-v4-pro-none

# === Token-Optimierung ===
# In-Memory LLM-Response-Cache (1=aktiv, 0=deaktiviert)
LLM_CACHE_ENABLED=1
# Cache-Gültigkeitsdauer in Sekunden (Standard: 1h)
LLM_CACHE_TTL=3600
# Maximale Einträge im Cache (LRU-Eviction bei Überschreitung)
LLM_CACHE_MAXSIZE=500
# Maximale Anzahl Nachrichten im Gesprächsverlauf (Sliding Window, reduziert Input-Token)
HISTORY_MAX_TURNS=12

# === Supabase (Datenbank, Auth, Storage) ===
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_oder_anon_key

# === Stripe (Zahlungen) ===
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# === Resend (E-Mail) — transactional only (contact/offers/booking) ===
RESEND_API_KEY=re_xxxx
RESEND_DOMAIN=mail.nexifyai.cloud
SENDER_EMAIL=mail@nexifyai.cloud
INTERNAL_NOTIFY_EMAIL=mail@nexifyai.cloud
REPLY_TO_EMAIL=mail@nexifyai.cloud

# === Hostinger SMTP — cold/drip outreach (scripts/outreach) ===
# Login uses IMAP_USER/IMAP_PASSWORD (same mailbox) unless SMTP_USER/SMTP_PASSWORD set.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=mail@nexifyai.cloud
SMTP_PASSWORD=

# === IMAP (E-Mail-Empfang + SMTP login for Hostinger) ===
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=mail@nexifyai.cloud
IMAP_PASSWORD=dein-imap-passwort

# === Lead outreach (scripts/outreach) ===
OUTREACH_DAILY_CAP=800
OUTREACH_PACE_MIN_SEC=30
OUTREACH_PACE_MAX_SEC=60
OUTREACH_LIVE=0
FIRECRAWL_URL=http://127.0.0.1:3003
FIRECRAWL_API_KEY=
OUTREACH_UNSUBSCRIBE_URL=https://www.nexifyai.cloud/api/outreach/unsubscribe
OUTREACH_BOOKING_URL=https://www.nexifyai.cloud/de/kontakt

# === Cloudflare ===
CF_ZONE_ID=2b96bbce5033dd364440906cea99b086
CF_GLOBAL_KEY=dein-global-key
CF_EMAIL=dein@email.com

# === Hermes WebUI (SSO) ===
WEBUI_SSO_SECRET=shared-secret-mit-hermes-webui
WEBUI_SSO_URL=https://work.nexifyai.cloud

# === Paperclip ===
PAPERCLIP_API_KEY=dein-paperclip-key
PAPERCLIP_API_URL=http://127.0.0.1:3100/api

# === n8n (ABGESCHAFFT — nicht setzen / nicht integrieren) ===
# N8N_BASE_URL=
# N8N_API_KEY=

# === Umgebung ===
TZ=Europe/Berlin
PYTHONPATH=/app/backend
FRONTEND_URL=https://www.nexifyai.cloud
CORS_ORIGINS=*
