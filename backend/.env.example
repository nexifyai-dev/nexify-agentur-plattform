# === NeXify AI — Backend Konfiguration ===
# Kopiere dies nach .env und fülle die Werte aus.

# === 9router AI (Primärer LLM-Provider) ===
NINEROUTER_BASE_URL=https://ai-router.nexifyai.cloud/v1
NINEROUTER_API_KEY=dein-9router-system-key
PRIMARY_MODEL=nexifyai-combo-llm
FALLBACK_MODEL=ds/deepseek-chat

# === §10 Systemweite Standardmodelle (3 Modelle, task-basiertes Routing) ===
# 1. Upstage Solar Pro 3 — Premium DE/NL-Qualität (Primär-Provider per §10)
UPSTAGE_MODEL=upstage/solar-pro3
# 2. DeepSeek Chat (V3.2) — strukturiertes JSON, Angebote, Pläne (§10-Ausnahme: vollintegriert)
DEEPSEEK_MODEL=ds/deepseek-chat
# 3. Upstage Solar Mini — günstigstes Standardmodell für Support & einfache Texte
UPSTAGE_MINI=upstage/solar-mini
# Optional: DeepSeek Reasoning für komplexe interne Aufgaben (kein Kunden-Output direkt)
DEEPSEEK_REASONER=ds/deepseek-v4-pro-none

# === Token-Optimierung ===
# In-Memory LLM-Response-Cache (1=aktiv, 0=deaktiviert)
LLM_CACHE_ENABLED=1
# Cache-Gültigkeitsdauer in Sekunden (Standard: 1h)
LLM_CACHE_TTL=3600
# Maximale Einträge im Cache (LRU-Eviction bei Überschreitung)
LLM_CACHE_MAXSIZE=500
# Maximale Anzahl Nachrichten im Gesprächsverlauf (Sliding Window, reduziert Input-Token)
HISTORY_MAX_TURNS=12

# === Supabase (Datenbank, Auth, Storage) ===
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=service_role_key_oder_anon_key

# === Stripe (Zahlungen) ===
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# === Resend (E-Mail) ===
RESEND_API_KEY=re_xxxx
RESEND_DOMAIN=mail.nexifyai.cloud

# === IMAP (E-Mail-Empfang) ===
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=mail@nexifyai.cloud
IMAP_PASSWORD=dein-imap-passwort

# === Cloudflare ===
CF_ZONE_ID=2b96bbce5033dd364440906cea99b086
CF_GLOBAL_KEY=dein-global-key
CF_EMAIL=dein@email.com

# === Hermes WebUI (SSO) ===
WEBUI_SSO_SECRET=shared-secret-mit-hermes-webui
WEBUI_SSO_URL=https://work.nexifyai.cloud

# === Paperclip ===
PAPERCLIP_API_KEY=dein-paperclip-key
PAPERCLIP_API_URL=http://127.0.0.1:3100/api

# === n8n (Workflow-Automatisierung) ===
N8N_BASE_URL=https://n8n.nexifyai.cloud
N8N_API_KEY=dein-n8n-api-key

# === Umgebung ===
TZ=Europe/Berlin
PYTHONPATH=/app/backend
