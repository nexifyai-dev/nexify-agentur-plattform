{
  "extensions": [
    {
      "id": "nexifyai-app-memory",
      "name": "NeXify AI Brain",
      "description": "AgentMemory (Brain) als Tab (same-origin Proxy /agentmemory/ → 127.0.0.1:3113)",
      "scripts": [
        "assets/app-memory.js"
      ],
      "stylesheets": [
        "assets/app-shared.css"
      ],
      "enabled": true,
      "permissions": {
        "storage": {
          "owned": true
        }
      },
      "settings_schema": [
        {
          "key": "url",
          "type": "string",
          "label": "AgentMemory URL",
          "default": "/agentmemory/"
        }
      ]
    },
    {
