# Vercel Environment Variables — aus /etc/nexifyai/hermes.env kopieren
# Niemals diese Datei mit echten Werten committen!
# Source of Truth: /etc/nexifyai/hermes.env (root:600 auf VPS srv1243952)

# --- Chat-KI (Live AI Chat-Widget) ---
# KEY in hermes.env: NINEROUTER_API_KEY
# WICHTIG: Public-Endpoint verwenden, NICHT localhost!
NINEROUTER_API_KEY=
NINEROUTER_ENDPOINT=https://ai-router.nexifyai.cloud/v1

# --- Backend (Login, Konto, Rückruf, Kontaktformular) ---
# KEY in hermes.env: (FastAPI-Backend-URL — leer lassen wenn kein Backend läuft)
BACKEND_ORIGIN=

# --- E-Mail (Kontaktformular, Rückruf-Bestätigung) ---
# KEY in hermes.env: RESEND_API_KEY
RESEND_API_KEY=
CONTACT_TO_EMAIL=mail@nexifyai.cloud
CONTACT_FROM_EMAIL=NeXify AI Website <website@nexifyai.cloud>

# --- Public (bereits gesetzt) ---
NEXT_PUBLIC_SITE_URL=https://www.nexifyai.cloud
NEXT_PUBLIC_WEBUI_URL=https://webui.nexifyai.cloud
