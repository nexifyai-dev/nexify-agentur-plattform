# --- Public site config ---
NEXT_PUBLIC_SITE_URL=https://www.nexifyai.cloud

# Base URL the client uses for API calls (contact/offer/planner/chat).
# Leave empty to hit the built-in Next.js API routes on the same origin.
NEXT_PUBLIC_BACKEND_URL=

# Hermes WebUI URL linked from the admin area.
NEXT_PUBLIC_WEBUI_URL=https://webui.nexifyai.cloud

# --- Server-only ---
# If set, Next.js rewrites /api/* to this origin (proxy to the VPS backend).
# Leave empty to serve the local app/api/* routes instead.
BACKEND_ORIGIN=

# Transactional email (used once the contact/offer routes send mail).
RESEND_API_KEY=
CONTACT_TO_EMAIL=mail@nexifyai.cloud
CONTACT_FROM_EMAIL=NeXify AI Website <website@nexifyai.cloud>
