# --- Public site config ---
NEXT_PUBLIC_SITE_URL=https://www.nexifyai.cloud

# Base URL the client uses for API calls (contact/offer/planner/chat).
# Leave empty to hit the built-in Next.js API routes on the same origin.
NEXT_PUBLIC_BACKEND_URL=

# Hermes WebUI URL linked from the admin area.
NEXT_PUBLIC_WEBUI_URL=https://webui.nexifyai.cloud

# --- Server-only ---
# Absolute origin of the FastAPI backend (must include scheme + hostname).
# Examples: http://127.0.0.1:8001  or  https://api.example.com
# Leave EMPTY on Vercel until DNS/host is live. An empty/"https://"/invalid
# value previously caused production 502 DNS_HOSTNAME_EMPTY for /api/auth/*
# and /api/chat/* via next.config rewrites.
# Local Next handlers (contact, offers, planner, chat) + catch-all proxy
# cover the paths; rewrite is only added when this parses to a real host.
BACKEND_ORIGIN=

# Transactional email fallback when FastAPI BACKEND_ORIGIN is unset/unreachable.
# Used by /api/contact and /api/offers/request (admin notification). Without this
# key those routes return honest 503 instead of pretending success.
# Auth/Login/Register/Booking still require a live FastAPI BACKEND_ORIGIN.
RESEND_API_KEY=
CONTACT_TO_EMAIL=mail@nexifyai.cloud
CONTACT_FROM_EMAIL=NeXify AI Website <website@nexifyai.cloud>
