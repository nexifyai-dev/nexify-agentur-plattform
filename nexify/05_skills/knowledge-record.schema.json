{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexify.local/schemas/knowledge-record.schema.json",
  "title": "NeXify Knowledge Record",
  "description": "Canonical knowledge-record schema for NeXify Knowledge Data Engineer. Used for cross-system persistence (Supermemory, Brain, Qdrant).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "source_id",
    "source_uri",
    "source_type",
    "source_sha256",
    "source_authority",
    "source_observed_at_berlin",
    "ingested_at_berlin",
    "project_id",
    "scope",
    "data_class",
    "knowledge_class",
    "content_type",
    "language",
    "title",
    "canonical_content",
    "dedupe_key",
    "canonical_status",
    "conflict_status",
    "freshness_status",
    "pii_status",
    "secret_status",
    "redaction_status",
    "retention_class",
    "container_tag",
    "quality_score",
    "quality_checks",
    "provenance",
    "lineage",
    "tags"
  ],
  "properties": {
    "record_id":                { "type": "string", "pattern": "^[a-z0-9-]{8,128}$" },
    "source_id":                { "type": "string", "minLength": 1 },
    "source_uri":               { "type": "string", "minLength": 1 },
    "source_type":              { "enum": ["file", "chat", "rule", "evidence", "register", "repo", "log", "mcp_response", "supermemory", "brain", "manual"] },
    "source_sha256":            { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_authority":         { "enum": ["systemmaster", "governance", "quality", "operating-data", "customer", "personal", "external"] },
    "source_version":           { "type": "string" },
    "source_created_at":        { "type": "string", "format": "date-time" },
    "source_observed_at_berlin":{ "type": "string", "format": "date-time" },
    "ingested_at_berlin":       { "type": "string", "format": "date-time" },
    "project_id":               { "type": "string" },
    "customer_id":              { "type": ["string", "null"] },
    "scope":                    { "enum": ["nexify_internal", "shared_infrastructure", "customer_project", "personal_pascal", "public_reference"] },
    "data_class":               { "enum": ["public", "internal", "confidential", "restricted", "secret"] },
    "knowledge_class":          { "enum": ["canonical", "operational", "evidence", "capability", "runtime", "archive", "pending"] },
    "content_type":             { "enum": ["text/markdown", "text/yaml", "text/json", "text/plain", "application/code", "application/config", "application/dataset"] },
    "language":                 { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "title":                    { "type": "string", "minLength": 1, "maxLength": 512 },
    "summary":                  { "type": "string", "maxLength": 4096 },
    "canonical_content":        { "type": "string", "minLength": 1 },
    "chunk_id":                 { "type": ["string", "null"] },
    "parent_record_id":         { "type": ["string", "null"] },
    "sequence":                 { "type": ["integer", "null"], "minimum": 0 },
    "dedupe_key":               { "type": "string", "minLength": 16, "pattern": "^[a-f0-9:_-]+$" },
    "semantic_cluster_id":      { "type": ["string", "null"] },
    "canonical_status":         { "enum": ["draft", "active", "superseded", "retracted", "archived"] },
    "conflict_status":          { "enum": ["none", "detected", "resolved", "unresolved"] },
    "supersedes":               { "type": "array", "items": { "type": "string" } },
    "superseded_by":            { "type": ["string", "null"] },
    "valid_from":               { "type": ["string", "null"], "format": "date-time" },
    "valid_until":              { "type": ["string", "null"], "format": "date-time" },
    "freshness_status":         { "enum": ["fresh", "aging", "stale", "expired"] },
    "pii_status":               { "enum": ["none", "minimized", "redacted", "rejected"] },
    "secret_status":            { "enum": ["none", "scanned", "redacted", "rejected"] },
    "redaction_status":         { "enum": ["none", "partial", "full", "blocked_on_secret"] },
    "retention_class":          { "enum": ["ephemeral", "operational", "long_term", "permanent"] },
    "container_tag":            { "type": "string", "pattern": "^[a-z0-9:_/-]+$" },
    "embedding_model":          { "type": ["string", "null"], "description": "Kanonisch: nscale/Qwen/Qwen3-Embedding-8B (NeXify Embedding LLM via 9Router)" },
    "embedding_dimensions":     { "type": ["integer", "null"], "minimum": 1 },
    "processing_model":         { "type": ["string", "null"], "description": "Kanonisch: nscale/chat/openai/gpt-oss-120b (NeXify Supermemory LLM via 9Router)" },
    "processing_prompt_version":{ "type": ["string", "null"] },
    "quality_score":            { "type": "number", "minimum": 0, "maximum": 1 },
    "quality_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_valid", "pii_check", "secret_check", "conflict_check"],
      "properties": {
        "schema_valid":  { "type": "boolean" },
        "pii_check":     { "type": "boolean" },
        "secret_check":  { "type": "boolean" },
        "conflict_check":{ "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_chain", "import_method", "importer"],
      "properties": {
        "source_chain":  { "type": "array", "items": { "type": "string" } },
        "import_method": { "enum": ["manual", "scanner", "webhook", "plugin", "migration"] },
        "importer":      { "type": "string" }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "derived_from": { "type": "array", "items": { "type": "string" } },
        "transforms":   { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence_refs":  { "type": "array", "items": { "type": "string" } },
    "brain_refs":     { "type": "array", "items": { "type": "string" } },
    "supermemory_refs":{ "type": "array", "items": { "type": "string" } },
    "task_refs":      { "type": "array", "items": { "type": "string" } },
    "tags":           { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
