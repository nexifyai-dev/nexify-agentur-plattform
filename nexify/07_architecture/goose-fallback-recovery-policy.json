{
  "id": "goose-fallback-recovery-policy",
  "title": "Goose Fallback/Recovery Policy",
  "version": "1.0.0",
  "date": "2026-06-12",
  "role": "recovery-fallback-agent",
  "not_primary": true,
  "connected_systems": {
    "9router": "https://ai-router.nexifyai.cloud/v1",
    "brain": "read-only",
    "agentmemory": "read-write",
    "workspace": "/workspace/nexify"
  },
  "capabilities": [
    "brain-query-readonly",
    "agentmemory-diagnose",
    "container-service-status",
    "config-health-check",
    "emergency-scripts",
    "workspace-integrity-check"
  ],
  "recovery_scenarios": [
    {"scenario": "claude-code-down", "action": "check-config-auth-logs"},
    {"scenario": "9router-down", "action": "check-container-restart"},
    {"scenario": "brain-down", "action": "check-container-service-restart"},
    {"scenario": "agentmemory-hung", "action": "check-health-process-restart"},
    {"scenario": "workspace-inconsistent", "action": "git-status-identify-missing-files"}
  ]
}
