    { "name": "Dispatching-Engine", "function": "Erstellt und verteilt Aufgaben an Agenten", "technology": "MCP + Queue", "status": "planned" },
    { "name": "Wissens-Datenbank", "function": "Zentrales Wissensarchiv (migriert von Brain/Qdrant)", "technology": "Qdrant/Supabase", "status": "planned" },
    { "name": "Recherche-Engine", "function": "Internet-Recherche via you.com/Web-Suche", "technology": "you.com API", "status": "planned" },
