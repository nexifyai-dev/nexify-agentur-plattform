  },
  "core_tasks": [
    { "task": "Frage-Routing", "description": "Alle eingehenden Fragen analysieren und an den zuständigen Experten routen", "priority": "P1" },
    { "task": "Auftrags-Management", "description": "Kundenaufträge und interne Arbeiten erfassen, priorisieren und zuweisen", "priority": "P1" },
    { "task": "Agenten-Dispatch", "description": "Aufgaben an die richtigen Sub-Agenten verteilen", "priority": "P1" },
    { "task": "Wissens-Management", "description": "Zentrales Wissensarchiv pflegen und Konsistenz sichern", "priority": "P2" },
    { "task": "Kanban-Pflege", "description": "Zentrales Kanban-Board aktualisieren und überwachen", "priority": "P2" },
    { "task": "Recherche", "description": "Internet/you.com für Recherchen nutzen, wenn internes Wissen nicht ausreicht", "priority": "P3" },
    { "task": "Archivierung", "description": "Abgeschlossene Aufgaben und Entscheidungen archivieren", "priority": "P3" }
