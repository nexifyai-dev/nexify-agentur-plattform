{
  "id": "rtk-configuration",
  "date": "2026-06-23",
  "current_config": {
    "enabled": true,
    "threshold": 0.5,
    "target_ratio": 0.2,
    "protect_last_n": 20,
    "protect_first_n": 3
  },
  "recommended_aggressive": {
    "enabled": true,
    "threshold": 0.3,
    "target_ratio": 0.15,
    "protect_last_n": 10,
    "protect_first_n": 2
  },
  "rtk_strategies": [
    "Caveman Output (40-70%)",
    "Input Filter (50-90% on logs/git/tree)",
    "Threshold Auto-Tune",
    "Redundancy Detection",
    "Summary Injection",
    "Context Pruning"
  ],
  "caveman_rules": {
    "remove_articles": ["der", "die", "das", "den", "dem", "des", "ein", "eine", "einen", "einer", "eines", "the", "a", "an"],
    "remove_filler": ["just", "really", "basically", "actually", "simply", "absolutely", "definitely", "pretty", "quite", "rather", "so", "very", "eben", "halt", "einfach", "ja", "mal", "auch", "nur", "schon", "doch", "wohl", "eigentlich", "natürlich", "vielleicht", "irgendwie"],
    "remove_pleasantry": ["sure", "happy", "glad", "welcome", "gern", "gerne", "natürlich", "sehr gerne", "freut mich"],
    "shorten_phrases": {
      "implement a solution": "fix",
      "I would recommend": "use",
      "it is important to note": "",
      "you need to": "→",
      "we need to": "→"
    }
  },
  "input_filter_modes": {
    "grep": "Keep only lines matching pattern",
    "git": "Strip git noise (deletions, binary, stats)",
    "tree": "Simplify directory tree (drop node_modules, .git, __pycache__, .venv)",
    "logs": "Dedup + level filter (keep ERROR/WARN, drop DEBUG/TRACE)"
  }
}
