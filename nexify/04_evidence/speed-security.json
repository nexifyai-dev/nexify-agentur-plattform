{
  "speed": {
    "autoMinify": {
      "enabled": true,
      "html": true,
      "css": true,
      "javascript": true
    },
    "brotli": { "enabled": true },
    "http2": { "enabled": true },
    "http3": { "enabled": true },
    "earlyHints": { "enabled": true },
    "mirage": {
      "enabled": true,
      "description": "Mobile Image Optimization"
    }
  },
  "security": {
    "ssl": {
      "mode": "full",
      "minTlsVersion": "1.2",
      "automaticHttpsRewrites": true,
      "alwaysUseHttps": true
    },
    "waf": {
      "managedRules": true,
      "cloudflareManagedRuleset": true,
      "owaspRuleset": true
    },
    "ddos": {
      "l3l4": true,
      "l7": true,
      "sensitivity": "medium"
    },
    "botManagement": {
      "enabled": true,
      "fightMode": true
    },
    "challengePages": {
      "enabled": true,
      "type": "managed"
    },
    "firewallRules": [
      {
        "name": "Block Bad Bots",
        "expression": "(cf.threat_score gt 14)",
        "action": "challenge"
      },
      {
        "name": "Rate Limit API",
        "expression": "(http.request.uri.path contains \"/api/\")",
        "action": "rate_limit",
        "rateLimit": {
          "requestsPerPeriod": 100,
          "period": 60
        }
      }
    ]
  }
}
