set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -z "$ROOT" ]] && exit 0

if [[ -x "$ROOT/.githooks/post-commit" ]]; then
  exec bash "$ROOT/.githooks/post-commit"
fi

HELPER="$ROOT/scripts/brain-dual-write.sh"
if [[ -f "$HELPER" ]]; then
  bash "$HELPER" commit >/dev/null 2>&1 || true
fi
exit 0
