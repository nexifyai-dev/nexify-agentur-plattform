# FILE: /.env.example
# NIR: 02.08.2026 09:05
# UPDATED: 02.08.2026 09:05
# WHAT: Root pointer for NeXify monorepo secrets/placeholders.
# WHY: Agents/CI look here first; real values live only in secret stores.
# PITFALL: Never commit a filled .env (gitignored).
# DOCS-REF: docs/operations/HUMAN-GATE-5MIN.md · docs/operations/GITHUB-ACTIONS-SECRET-REGISTRY.md

# Backend / Website LLM → see backend/.env.example (9router Vollintegration)
#   NINEROUTER_BASE_URL / NINEROUTER_API_KEY / PRIMARY_MODEL / CUSTOMER_MODEL / FALLBACK_MODEL
# Cheap-first combos (system default): nexifyai-cheap-first · nexifyai-combo-llm

# Hermes (VPS) OpenAI-compat → 9router
# OPENAI_BASE_URL=http://127.0.0.1:20128/v1
# OPENAI_API_KEY=<same-as-NINEROUTER_API_KEY>
# Gateway health (local): http://127.0.0.1:8644/health
# Hermes env file on VPS: /etc/nexifyai/hermes.env (not this root .env)

# Docs: docs/architecture/9ROUTER_VOLLINTEGRATION.md

# ── AgentMemory + LightRAG (Brain dual-write) ────────────────────────────────
# AGENTMEMORY_URL=http://127.0.0.1:3111
# AGENTMEMORY_SECRET=<bearer-from-secret-store>
# AGENTMEMORY_TOOLS=all
# AGENTMEMORY_INJECT_CONTEXT=true
# LIGHTRAG_URL=http://127.0.0.1:9622
# Install hook: bash scripts/install-dual-write-hook.sh
# Seed SoT: bash scripts/lightrag-sot-seed.sh

# ── Circuit Breaker (cost gate before MCP / Cloud Agent) ─────────────────────
# CIRCUIT_BREAKER_URL=http://127.0.0.1:8912
# Hook: .cursor/hooks/circuit-breaker-mcp.sh → POST /check

# ── Cursor Cloud / Event-Ingest (names only; values in secret store) ─────────
# CURSOR_API_KEY=<github-actions-secret>
# EVENT_INGEST_SHARED_SECRET=<vps-only>
# Install: bash deploy/autopilot/install-event-ingest.sh
# VPS file: /opt/nexifyai/config/cursor-cloud.env

# ── Paperclip (stub — do NOT revive autopilot timer) ─────────────────────────
# PAPERCLIP_API_URL=http://127.0.0.1:3100/api
# Issue #150: revive disabled; apps/paperclip is Planned stub only.

# ── n8n ──────────────────────────────────────────────────────────────────────
# ABGESCHAFFT — nicht konfigurieren / nicht integrieren.

# ── Harness Open Source ────────────────────────────────────────────────────────
# Docs: docs/architecture/HARNESS-INTEGRATION.md
# Setup: infra/harness/setup.sh
#
# HARNESS_DB_NAME=harnessdb
# HARNESS_DB_USER=harness
# HARNESS_DB_PASSWORD=<sicheres-passwort-setzen>
# HARNESS_ADMIN_EMAIL=admin@nexifyai.cloud
# HARNESS_ADMIN_PASSWORD=<sicheres-passwort-setzen>
# HARNESS_URL_BASE=https://harness.nexifyai.cloud
# HARNESS_URL_GIT=https://harness.nexifyai.cloud
#
# Ports (auf dem VPS):
#   3101  → Harness Web UI (intern: 3000)
#   3022  → Git-over-SSH
#   5433  → Harness PostgreSQL (intern: 5432)

# ── System deps (docs reminder for cold agents) ──────────────────────────────
# Website: pnpm (Node 20+), see apps/website
# Backend: python3.12-venv, pip install -r backend/requirements.txt
# Lead demos path: sudo mkdir -p /opt/nexifyai/repos/lead-pipeline/demos

