# FILE: deploy/docker/Dockerfile.vitrine
# NIR: 25.07.2026 11:00
# NAME: NeXifyAI Agent
# TEAM: NeXifyAI DevOps
# WHAT: Production Dockerfile für die Vitrine (Marketing-Website) — apps/website
# WHY: Korrekte pnpm-basierte Multi-Stage-Build; Yarn ist nur ein Nebenprodukt der CRA-Migration
# BEST-PRACTICE: pnpm install --frozen-lockfile sichert reproduzierbare Builds
# PITFALL: V-01: yarn.lock im apps/website existiert, aber pnpm ist der offizielle Package Manager
# DEPENDS: Node.js 22 Alpine, pnpm@9, NEXT_TELEMETRY_DISABLED
# DOCS-REF: apps/website/package.json, deploy/docker/Dockerfile.website

FROM node:22-alpine AS builder
WORKDIR /app

# Enable pnpm via corepack (bundled with Node.js 22)
RUN corepack enable && corepack prepare pnpm@9 --activate

# All COPY paths below are relative to the Docker build context (apps/website/).
# When invoked via `build.yml`, context is set to `./apps/website`, so
# `package.json` resolves to `apps/website/package.json`, etc.
COPY package.json pnpm-lock.yaml ./
COPY pnpm-workspace.yaml* ./
RUN pnpm install --frozen-lockfile

# Copy source and build
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build


FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup -S nodejs && adduser -S nextjs
RUN apk add --no-cache curl

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD curl -sf http://localhost:3000/api/health || exit 1

CMD ["node", "server.js"]
