# FILE: deploy/docker/Dockerfile.backend
# NIR: 25.07.2026 11:00
# NAME: NeXifyAI Agent
# TEAM: NeXifyAI DevOps
# WHAT: Production Dockerfile für den FastAPI-Backend-Server
# WHY: Reproduzierbarer Container-Build für den NeXify-API-Server
# BEST-PRACTICE: Python Slim-Image; Nicht-Root-User; Healthcheck via /health
# PITFALL: V-01: requirements.txt hatte private Pakete (emergentintegrations, custom litellm-Wheel).
#          Diese wurden entfernt/durch öffentliche PyPI-Versionen ersetzt, da sie im Code
#          nicht verwendet werden. Alle Abhängigkeiten sind nun öffentlich über PyPI verfügbar.
# DEPENDS: Python 3.11, Supabase Postgres (asyncpg), Resend, NINEROUTER_BASE_URL, NINEROUTER_API_KEY
# DOCS-REF: backend/requirements.txt, backend/.env.example, backend/server.py

FROM python:3.11-slim AS builder

WORKDIR /app

# Install build tools and system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt


FROM python:3.11-slim AS runner

WORKDIR /app
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
# Product default language: German (de) — see docs/operations/LOCALE-DE-STANDARD.md

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r nexify && useradd -r -g nexify nexify

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application source
COPY --chown=nexify:nexify . .

USER nexify

EXPOSE 8000

# UVICORN_WORKERS: override at runtime via environment variable (e.g. docker run -e UVICORN_WORKERS=4)
ENV UVICORN_WORKERS=2

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -sf http://localhost:8000/health || exit 1

CMD sh -c "uvicorn server:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS}"
