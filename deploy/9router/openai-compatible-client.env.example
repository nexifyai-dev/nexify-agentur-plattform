# FILE: /deploy/9router/openai-compatible-client.env.example
# WHAT: OpenAI-compatible Client → NeXify 9router (ai-router)
# WHY: Cursor / OpenAI SDKs / Hermes nutzen dasselbe /v1 Schema.
# PITFALL: Key nur aus 9router apiKeys (Standard LLM Key); nie committen.
# LIVE DB: ~/.9router/db/data.sqlite auf VPS

# --- Public (Cloudflare) ---
OPENAI_BASE_URL=https://ai-router.nexifyai.cloud/v1
OPENAI_API_KEY=sk-...   # 9router → apiKeys → "Standard LLM Key"

# --- VPS lokal ---
# OPENAI_BASE_URL=http://127.0.0.1:20128/v1

# Modelle (Live 2026-07-25)
# Customer / sauberer Text:
#   ds/deepseek-v4-flash
# Agent / Combo (flash → openrouter deepseek-v3.2 → v4-pro):
#   nexifyai
#   nexifyai-combo-llm
PRIMARY_MODEL=nexifyai-combo-llm
CUSTOMER_MODEL=ds/deepseek-v4-flash
FALLBACK_MODEL=ds/deepseek-v4-flash

# Alias für manche Clients
NINEROUTER_BASE_URL=https://ai-router.nexifyai.cloud/v1
NINEROUTER_API_KEY=${OPENAI_API_KEY}
